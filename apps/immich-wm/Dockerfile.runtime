# M0 transfer fallback: frontend must already be built locally.
FROM public.ecr.aws/docker/library/python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641
RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends libimage-exiftool-perl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY packages/kari-core packages/kari-core
COPY apps/api apps/api
COPY apps/immich-wm/worker apps/immich-wm/worker
COPY assets/fonts assets/fonts
COPY assets/logos assets/logos
COPY pyproject.toml pyproject.toml
RUN sed 's|https://files.pythonhosted.org/packages/|https://mirrors.tuna.tsinghua.edu.cn/pypi/web/packages/|g' \
    apps/immich-wm/worker/requirements-linux-amd64.lock > /tmp/runtime-requirements.lock \
    && pip install --no-cache-dir --no-deps --require-hashes -r /tmp/runtime-requirements.lock \
    && PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple pip install --no-cache-dir --no-deps -e ./packages/kari-core -e ./apps/api -e ./apps/immich-wm/worker \
    && pip check \
    && groupadd --gid 10001 imprint && useradd --uid 10001 --gid imprint --no-create-home imprint \
    && mkdir -p /data /output /imports && chown imprint:imprint /data /output
COPY apps/immich-wm/web/dist /app/web
RUN mkdir -p /app/assets/logos /app/packages/kari-core/config/templates
ENV KARI_IMPRINT_ASSETS_DIR=/app/assets KARI_IMPRINT_ROOT=/app WM_WEB_ROOT=/app/web
RUN chmod -R a+rX /app/assets/logos
USER 10001:10001
EXPOSE 2285
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:2285/api/health'))['ok']"
CMD ["immich-wm", "--host", "0.0.0.0"]
